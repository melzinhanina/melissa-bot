# Copie para .env no Termux. Nunca publique valores reais de chaves.

# IA direta da Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Portkey como router de IA
PORTKEY_API_KEY=
PORTKEY_MODEL=openai/gpt-oss-120b
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Ajuste ao identificador da integração/provedor configurado no Portkey
PORTKEY_PROVIDER=groq

# Pesquisa web Tavily
TAVILY_API_KEY=

# Ajustes opcionais do gerenciador de IA
AI_PROVIDER_ORDER=groq,portkey
AI_CONCURRENCY=2
AI_QUEUE_MAX=100
AI_TIMEOUT_MS=30000
AI_RETRIES=2
