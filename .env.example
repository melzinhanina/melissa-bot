# Copie para .env no Termux. Nunca publique valores reais de chaves.

# IA direta da Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Portkey como router de IA
PORTKEY_API_KEY=
PORTKEY_MODEL=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Slug da integração no Portkey Model Catalog (ex.: mel ou melissa)
PORTKEY_PROVIDER=mel
# Opcional: ID de uma Gateway Config salva no Portkey
PORTKEY_CONFIG_ID=

# Número da dona do bot, com código do país e DDD, somente dígitos (ex.: 5598999999999)
OWNER_NUMBER=

# Pesquisa web Tavily
TAVILY_API_KEY=

# Melissa Downloader API: extrai links de TikTok/Instagram; o bot baixa a mídia localmente.
MELISSA_DOWNLOADER_API_URL=https://melissa-downloader-api.onrender.com/extract
MELISSA_DOWNLOADER_API_KEY=

# Ajustes opcionais do gerenciador de IA
AI_PROVIDER_ORDER=groq,portkey
AI_CONCURRENCY=2
AI_QUEUE_MAX=100
AI_TIMEOUT_MS=30000
AI_RETRIES=2
